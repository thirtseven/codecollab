# Database Configuration
DB_URL=jdbc:mysql://127.0.0.1:3306/codecollab?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&defaultAuthenticationPlugin=mysql_native_password
DB_USERNAME=codecollab
DB_PASSWORD=your_database_password_here

# Mail Configuration (for verification codes)
MAIL_USERNAME=your_email@163.com
MAIL_PASSWORD=your_email_password_here

# JWT Secret (must be at least 256 bits)
JWT_SECRET=your_jwt_secret_key_here_at_least_256_bits_long

# AI Configuration
AI_API_KEY=your_ai_api_key_here
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-3.5-turbo
